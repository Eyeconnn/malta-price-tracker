      "slug": "telecom",
      "name": "Telecom Electronics",
      "base_url": "https://www.telecom.com.mt",
      "category": "electronics",
      "adapter": "html",
      "tier": "P1",
      "active": true,
      "config": {
        "html": {
          "start_urls": [
            "/en/shop.htm"
          ],
          "category_links": "a[href*=\"/en/shop/webshop/bycategory/\"]",
          "category_pattern": "/bycategory/\\d+/",
          "normalise": [
            "/bycategory/(\\d+)/name/asc/\\d+/\\d+/",
            "/bycategory/$1/name/asc/24/1/"
          ],
          "page_url": [
            "/24/1/([^/]+)\\.htm$",
            "/24/{page}/$1.htm"
          ],
          "last_page": "ul.pagination a.page-link",
          "tile": "div.card.shop-card",
          "link": ".card-title a",
          "id": {
            "url_regex": "/webshop/(\\d+)/"
          },
          "title": ".card-title a",
          "sku": ".card-body small.text-secondary",
          "brand": "small.d-block.text-c2",
          "price": ".item-sale-price, .card-footer div[class*=\"price_\"] > span.m-0",
          "old_price": ".card-footer span.text-decoration-line-through",
          "stock": ".card-body p.m-0 small",
          "in_stock": "in stock",
          "out_of_stock": "not available",
          "product": {
            "id": {
              "url_regex": "/webshop/(\\d+)/"
            },
            "title": "h1",
            "sku": "h3#sku",
            "brand": "span#product_brand",
            "gtin": ".shop-item-topright small.text-c5.d-block",
            "price": "div.shop-item-price span.text-c2.fw-bold, div.shop-item-price p.text-c2.fw-bold",
            "old_price": "div.shop-item-price span.text-decoration-line-through",
            "stock": "span.stock-notice-instock"
          }
        },
        "sku_is_gtin": true,
        "runner": "local"
      },
      "notes": "Custom shop. Sitemap has no products; categories from /en/shop.htm, 24 per page. \"Not Available Online\" products show prices but count as out of stock. Refuses GitHub Actions IPs (403, 20 Oct): runs locally."
