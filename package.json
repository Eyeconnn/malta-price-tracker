{
  "name": "malta-price-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily price logging for Maltese web shops, to test Black Friday discounts against the EU 30-day lowest price rule.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "scrape": "tsx src/cli/scrape.ts",
    "scrape-due": "tsx src/cli/scrape-due.ts",
    "summary": "tsx src/cli/summary.ts",
    "snapshot": "tsx src/cli/snapshot.ts",
    "site-build": "tsx src/cli/site-build.ts",
    "normalise-names": "tsx src/cli/normalise-names.ts",
    "judge-matches": "tsx src/cli/judge-matches.ts",
    "probe": "tsx src/cli/probe.ts",
    "shop-requests": "tsx src/cli/shop-requests.ts",
    "export-shops": "tsx src/cli/export-shops.ts",
    "fetch-logos": "tsx src/cli/fetch-logos.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "dev-db": "tsx scripts/dev-db.ts",
    "sql": "tsx scripts/sql.ts",
    "dashboard:dev": "wrangler dev --cwd dashboard --port 8787",
    "dashboard:deploy": "wrangler deploy --cwd dashboard",
    "web:dev": "vite",
    "web:worker": "wrangler dev --cwd web --ip 127.0.0.1 --port 8788",
    "web:build": "vite build",
    "web:deploy": "vite build && wrangler deploy --cwd web"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@neondatabase/serverless": "^1.2.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.1.7",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "19.3.1",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
