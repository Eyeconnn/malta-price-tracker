      "sizes": { "type": "text", "multi": true, "meaning": "sizes the group comes in, for example 0-3 months, size 4" },
      "pack_count": { "type": "number", "unit": "items", "min": 1, "max": 500, "meaning": "items in the pack" },
      "colour": { "type": "enum", "list": "colours", "multi": true, "meaning": "colours the group comes in" }
    },
    "fashion": {
