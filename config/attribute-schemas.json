      "product_type": { "type": "enum", "values": ["console", "game", "controller", "headset", "accessory", "gift card", "chair", "other"], "meaning": "kind of product" },
      "edition": { "type": "text", "meaning": "edition, for example Standard, Deluxe, Digital" },
