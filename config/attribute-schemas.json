{
  "_about": "Attribute keys per site category for the name normaliser (src/names). Types: text, enum (values, or list naming a shared list), number (fixed unit, min and max bounds). multi: the value is a list (for example every colour or size the group's variants come in). identity (not an attribute): the category's key specs for matching one product across shops by name (src/site/identity.ts); a spec both listings have must be equal, one only one side has does not block, and {key, default} counts a missing value as the default (a drink without a pack count is one bottle). Colour and size are variant options and never part of identity.",
  "lists": {
    "colours": [
      "black", "white", "grey", "silver", "gold", "rose gold", "bronze", "copper",
      "blue", "navy", "light blue", "turquoise", "red", "burgundy", "pink", "purple",
      "green", "olive", "khaki", "yellow", "orange", "beige", "cream", "brown",
      "multicolour", "transparent"
    ],
    "genders": ["men", "women", "unisex", "boys", "girls", "kids", "baby"]
  },
  "categories": {
    "laptops": {
      "identity": ["storage_gb", "ram_gb", "screen_in", "cpu", "gpu"],
      "brand": { "type": "text", "meaning": "maker of the laptop, in its usual spelling" },
      "model": { "type": "text", "meaning": "model name and number, without specs" },
      "screen_in": { "type": "number", "unit": "inch", "min": 7, "max": 21, "meaning": "screen diagonal" },
      "cpu": { "type": "text", "meaning": "processor as written by the shop, for example Intel Core i5-1335U" },
      "ram_gb": { "type": "number", "unit": "GB", "min": 1, "max": 256, "meaning": "memory" },
      "storage_gb": { "type": "number", "unit": "GB", "min": 16, "max": 16384, "meaning": "total storage, 1TB = 1024" },
      "storage_type": { "type": "enum", "values": ["SSD", "HDD", "eMMC", "SSD+HDD"], "meaning": "kind of storage" },
      "gpu": { "type": "text", "meaning": "graphics chip when named, for example RTX 4060" },
      "os": { "type": "enum", "values": ["Windows", "macOS", "ChromeOS", "Linux", "none"], "meaning": "operating system family (W11P, Win 11 Home are Windows)" },
      "colour": { "type": "enum", "list": "colours", "multi": true, "meaning": "colours the group comes in" }
    },
    "phones": {
      "identity": ["storage_gb", "ram_gb", "screen_in", "network"],
      "brand": { "type": "text", "meaning": "maker" },
      "model": { "type": "text", "meaning": "model name and number, without storage or colour" },
      "device_type": { "type": "enum", "values": ["phone", "tablet", "smartwatch", "e-reader", "accessory"], "meaning": "kind of device" },
      "storage_gb": { "type": "number", "unit": "GB", "min": 1, "max": 4096, "meaning": "built-in storage" },
      "ram_gb": { "type": "number", "unit": "GB", "min": 1, "max": 32, "meaning": "memory" },
      "screen_in": { "type": "number", "unit": "inch", "min": 1, "max": 16, "meaning": "screen diagonal" },
      "network": { "type": "enum", "values": ["4G", "5G", "Wi-Fi only"], "meaning": "best mobile network supported" },
      "sim": { "type": "enum", "values": ["single", "dual", "eSIM", "dual + eSIM"], "meaning": "SIM slots" },
      "colour": { "type": "enum", "list": "colours", "multi": true, "meaning": "colours the group comes in" }
    },
    "tv-audio": {
      "identity": ["screen_in", "resolution"],
      "brand": { "type": "text", "meaning": "maker" },
      "model": { "type": "text", "meaning": "model code or name" },
      "device_type": { "type": "enum", "values": ["tv", "soundbar", "headphones", "earbuds", "speaker", "projector", "home cinema", "hi-fi", "accessory", "other"], "meaning": "kind of product" },
      "screen_in": { "type": "number", "unit": "inch", "min": 10, "max": 120, "meaning": "screen diagonal (TVs only)" },
      "resolution": { "type": "enum", "values": ["HD", "Full HD", "4K", "8K"], "meaning": "screen resolution (UHD is 4K)" },
      "panel": { "type": "enum", "values": ["LED", "QLED", "Neo QLED", "OLED", "QD-OLED", "Mini LED", "NanoCell", "LCD"], "meaning": "screen technology" },
      "smart_os": { "type": "enum", "values": ["Google TV", "Android TV", "Tizen", "webOS", "Roku", "Fire TV", "VIDAA", "Titan OS", "other"], "meaning": "smart TV system" },
      "hdr": { "type": "text", "meaning": "HDR formats named by the shop, for example HDR10, Dolby Vision" },
      "refresh_hz": { "type": "number", "unit": "Hz", "min": 50, "max": 480, "meaning": "screen refresh rate" },
      "power_w": { "type": "number", "unit": "W", "min": 1, "max": 5000, "meaning": "audio output power" },
      "wireless": { "type": "enum", "values": ["yes", "no"], "meaning": "Bluetooth or other wireless audio" },
      "colour": { "type": "enum", "list": "colours", "multi": true, "meaning": "colours the group comes in" }
    },
    "gaming": {
