      "gender": { "type": "enum", "list": "genders", "meaning": "who it is made for" },
      "size_system": { "type": "enum", "values": ["EU", "UK", "US", "IT", "FR", "letter", "age", "one size"], "meaning": "how sizes are written" },
      "sizes": { "type": "text", "multi": true, "meaning": "sizes the group comes in, as the shop writes them, for example S, M, L or 42, 43" },
      "material": { "type": "text", "meaning": "main material, for example cotton, leather" },
      "fit": { "type": "enum", "values": ["regular", "slim", "relaxed", "oversized", "skinny", "straight", "loose"], "meaning": "cut" },
      "colour": { "type": "enum", "list": "colours", "multi": true, "meaning": "colours the group comes in" }
    },
