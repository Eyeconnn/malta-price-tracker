{
  "_about": "Attribute keys per site category for the name normaliser (src/names). Types: text, enum (values, or list naming a shared list), number (fixed unit, min and max bounds). multi: the value is a list (for example every colour or size the group's variants come in). identity (not an attribute): the category's key specs a specs summary may show after a clean name (src/site/identity.ts). Colour and size are variant options and never part of it. shared: attributes every category has (a category may define its own). canonical (not an attribute): the fields of the canonical name, in order, used to match one product across shops (src/names/canonical.ts); \"a|b\" takes the first field present; the shared fields condition, audience, pack_count, edition, format, refill, bundle and face_value follow whenever present. Colour and size are never part of it.",
  "lists": {
    "colours": ["black", "white", "grey", "silver", "gold", "rose gold", "bronze", "copper", "blue", "navy", "light blue", "turquoise", "red", "burgundy", "pink", "purple", "green", "olive", "khaki", "yellow", "orange", "beige", "cream", "brown", "multicolour", "transparent"],
    "genders": ["men", "women", "unisex", "boys", "girls", "kids", "baby"]
  },
  "shared": {
    "line": { "type": "text", "meaning": "the product line and model name as the maker writes it, without brand, colour, size, storage or pack size, for example Galaxy S25 Ultra, Black Label, Air Max 90, Technic Lamborghini Sian FKP 37" },
    "condition": { "type": "enum", "values": [ "used", "refurbished", "refurbished grade A", "refurbished grade B", "refurbished grade C", "open box", "ex-display", "damaged", "b-stock", "demo", "like new" ], "meaning": "condition when the title states one that is not new (Pre-owned is used, Renewed is refurbished); leave out for new" },
    "audience": { "type": "enum", "values": [ "kids", "junior", "boys", "girls", "baby", "toddler", "youth", "GS", "PS", "TD" ], "meaning": "a children's audience the title names; leave out for adults" },
    "edition": { "type": "text", "meaning": "edition or model variant word the title names, for example Deluxe Edition, Collector's Edition, GOTY, Starter Kit" },
    "format": { "type": "text", "meaning": "format the title names, for example Digital, Disc, Cartridge, Download Code" },
    "refill": { "type": "enum", "values": [ "yes", "no" ], "meaning": "yes when the product is a refill" },
    "bundle": { "type": "text", "meaning": "what comes with it when the title names a bundle, for example 2 Controllers, LEGO Bag" },
    "pack_count": { "type": "number", "unit": "items", "min": 1, "max": 500, "meaning": "items in the pack when the title names a pack or count (Pack of 6, 6x330ml, 44 Nappies, Twin Pack is 2)" },
    "face_value": { "type": "text", "meaning": "value with its currency of a gift card or voucher, for example €20" }
  },
  "categories": {
