# Postgres on Neon (pooled or direct connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend email alerts
RESEND_API_KEY=
ALERT_EMAIL=you@example.com
# Optional: sender address on a domain verified in Resend (defaults to onboarding@resend.dev)
ALERT_FROM=

# Sent on every request: <Token>/<version> (<short description>). The token is what robots.txt groups
# are matched against. Do not start it with Mozilla/5.0 and do not use example.com: several shop
# firewalls reject both.
SCRAPER_USER_AGENT=PriceIndexBot/0.1 (price index crawler)
